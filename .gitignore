# `data/` is ignored as a directory, but a SYMLINK named `data` is a file and
# slips past that — twice now a verification worktree pointed at the real sqlite
# file and `git add -A` committed an absolute link to a developer's machine.
/data

# Browser-verifying a branch needs a worktree INSIDE the project — Turbopack
# rejects a node_modules symlink that points outside it — so these land in the
# repo root, and each is a nested git checkout of ~150MB carrying its own
# .env.local. `git add -A` would either swallow the lot or write a stray
# gitlink. Anchored to the root so it cannot touch anything under src/, and
# matched by PATTERN so the next one is covered without editing this file.
# (git's `*` matches a leading dot, so `.pol-preview` is included.)
/*-preview/

# Local safety copies, not source. `backups/` holds source tarballs taken
# before a risky prod pull, and a `.bak` is whatever a script looked like
# before it was edited — both are useful on this machine and meaningless in
# the repo, where they would ship a second, stale copy of a deploy script.
/backups/
*.bak

# `tsc --noEmit` incremental cache. Regenerated on every typecheck, ~400KB of
# churn, and it encodes absolute paths from whoever ran it last.
*.tsbuildinfo
