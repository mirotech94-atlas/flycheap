# Amadeus Self-Service API — https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# 'test' uses developers.amadeus.com sandbox, 'production' uses live data (paid)
AMADEUS_ENV=test

# Resend — https://resend.com
RESEND_API_KEY=
# Verified sender (use onboarding@resend.dev for testing)
RESEND_FROM=onboarding@resend.dev
ALERT_EMAIL=myronmekhael5@gmail.com

# Cron cadence in minutes (Amadeus free tier is 2000/month — keep >=30)
POLL_INTERVAL_MINUTES=30

# SerpAPI (Google Flights) — https://serpapi.com
SERPAPI_KEY=

# SearchAPI.io (Google Flights) — https://www.searchapi.io
SEARCHAPI_KEY=

# Kiwi Tequila API — https://tequila-api.kiwi.com
KIWI_TEQUILA_KEY=

# ElevenLabs — the concierge's voice (TTS via /api/voice/tts, mic via Scribe
# at /api/voice/stt) and the narrated ops brief. Optional: with no key every
# surface falls back to the browser's own speech engines / a text-only brief.
# Paste the key HERE, never into a chat. Get it at elevenlabs.io → Profile → API keys.
ELEVENLABS_API_KEY=
# Optional voice override (any voice_id from the library, cloned voices included).
# Defaults to "Sarah" (EXAVITQu4vr4xnSDxMaL).
ELEVENLABS_VOICE_ID=

# Fare decision model — a small neural network trained nightly on our own
# polling history (job: fare-model). Set to "off" to run on the rules alone.
FARE_MODEL=on

# ---- Security-relevant settings (fail closed when unset) ----
# Slack user ids (U…) allowed to approve gated ops actions with "go". Unset = nobody.
OPS_APPROVER_SLACK_USER_IDS=
# Admin FarePilot SQL/commands need a fresh 6-digit code by default. The seed
# comes from here or from the owner's own 2FA. Set FAREPILOT_REQUIRE_STEPUP=0
# only to opt out deliberately.
OWNER_TOTP_SECRET=
FAREPILOT_REQUIRE_STEPUP=
# Inbound SMS (/api/twilio/incoming) is refused without the auth token.
# TWILIO_WEBHOOK_URL must equal the URL configured in the Twilio console.
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=
# Telegram updates are refused without it; re-run setWebhook after setting it.
TELEGRAM_WEBHOOK_SECRET=
