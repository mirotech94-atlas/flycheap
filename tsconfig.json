{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next.a/types/**/*.ts",
    ".next.a/dev/types/**/*.ts",
    ".next.b/types/**/*.ts",
    ".next.b/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "mobile",
    // The native shell has its own toolchain (@capacitor/cli lives in its own
    // package, not this one), so the web typecheck never resolves its config.
    "ios-app"
  ]
}
