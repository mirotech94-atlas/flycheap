{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next.a/types/**/*.ts",
    ".next.a/dev/types/**/*.ts",
    ".next.b/types/**/*.ts",
    ".next.b/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "mobile",
    "src.before-resync-bak",
    // Dead pre-rename snapshot. Next never routes it (the app dir is src/app),
    // it ships nothing, and typechecking it only reports drift against the
    // live tree it was copied from — which is what a snapshot is for.
    "src.before-rename-2026-09-09"
  ]
}
